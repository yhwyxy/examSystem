# Copy to .env. Set true to use cloud reranking; false uses the local model.
RERANK_USE_REMOTE=false
# All three values below are required when RERANK_USE_REMOTE=true.
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=

# scoring_worker: must match the Go server's scoring.multiple_choice_partial
# (config.yaml), or regraded per-question detail scores diverge from the
# objective_score column written at submit time.
MULTIPLE_CHOICE_PARTIAL=true
# scoring_worker lease/heartbeat tuning (seconds); heartbeat renews the job
# lease during long gradings, keep heartbeat < lease.
#LEASE_SECONDS=60
#HEARTBEAT_SECONDS=15
