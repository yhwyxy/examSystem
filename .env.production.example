# cp .env.production.example .env 后填写; .env 已被 gitignore, 严禁提交

# ---------- 必填 ----------
# PostgreSQL 应用角色密码 (强密码, 生产必改; 这是容器内唯一的 DB 角色, 同时用于迁移与运行)
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Go 服务 / worker 共用的连接串 (compose 网络内用服务名 postgres:5432)
# 外部托管 PG 时改成对应地址, 并按需 sslmode=require
EXAM_DATABASE_URL=postgres://exam_app:CHANGE_ME_STRONG_PASSWORD@postgres:5432/exam_system?sslmode=disable

# 管理端认证密码 (生产必设; 对应 config.production.yaml 的 admin.enable_auth=true)
EXAM_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---------- 可选: 数据库 ----------
PG_USER=exam_app
PG_DB=exam_system

# ---------- 可选: 对外暴露 ----------
# 默认只绑本机, 由反代 (Caddy/nginx) 转发; 直连公网时改成 0.0.0.0
EXAM_BIND_ADDR=127.0.0.1

# ---------- 可选: worker ----------
WORKER_ID=worker-1
# 必须与 config.yaml 的 scoring.multiple_choice_partial 一致
MULTIPLE_CHOICE_PARTIAL=true

# 评分方式 (三选一; 也可在管理后台「设置」栏热切换, 保存后以 DB 为准,
# 下面 env 仅作未保存前的启动默认):
#   local            本地语义模型 (需 WORKER_EXTRAS 构建, 镜像 ~2GB)
#   remote_reranker  远程 reranker API (Cohere 兼容), 需 RERANK_API_URL/KEY/MODEL
#   llm              大模型判分 API (OpenAI 兼容 chat/completions), 需 LLM_API_URL/KEY/MODEL
# SCORING_METHOD 显式指定时优先于 RERANK_USE_REMOTE
# SCORING_METHOD=local
RERANK_USE_REMOTE=false

# 本地模型模式 (RERANK_USE_REMOTE=false):
# 宿主模型目录 (模型根目录, 需含 config.json, 如 bge-reranker-v2-m3)
RERANKER_MODEL_DIR=./models
RERANKER_MODEL=/models/bge-reranker-v2-m3
# 构建镜像时加装 torch/sentence-transformers (镜像 ~2GB); 远程模式留空
WORKER_EXTRAS=sentence-transformers>=3.0 torch>=2.2,<3

# 远程 reranker 模式 (remote_reranker 必填; 并清空 WORKER_EXTRAS)
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=

# 大模型判分模式 (llm 必填; 并清空 WORKER_EXTRAS)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

LOG_LEVEL=INFO
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2.0
